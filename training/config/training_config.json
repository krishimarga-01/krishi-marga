{
  "model": {
    "architecture": "mobilenet_v3_small",
    "pretrained": true,
    "image_size": 224,
    "input_channels": 3,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    }
  },
  "training": {
    "epochs": 15,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "early_stopping_patience": 4,
    "num_workers": 2,
    "random_seed": 42
  },
  "split": {
    "train_ratio": 0.8,
    "val_ratio": 0.1,
    "test_ratio": 0.1
  },
  "onnx_export": {
    "opset_version": 17,
    "dynamic_batch": true,
    "output_name": "krishi_marga_disease_model.onnx"
  }
}