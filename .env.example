# ==============================================================================
# KRISHI MARGA — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure the appropriate values for your environment.
# NEVER commit your actual .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / EXPO MOBILE APP CONFIGURATION
# ------------------------------------------------------------------------------
# The n8n webhook or diagnosis server endpoint reachable from the mobile device.
# For local testing on a physical phone: use your machine's LAN IP (e.g. http://192.168.1.100:5678/webhook/detect-disease)
# For production: use your HTTPS endpoint (e.g. https://api.krishimarga.com/webhook/detect-disease)
EXPO_PUBLIC_BACKEND_URL=http://YOUR_LAN_IP_OR_DOMAIN:5678/webhook/detect-disease

# ------------------------------------------------------------------------------
# 2. AI / N8N WORKFLOW CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API key used by the n8n diagnosis workflow (Gemini 3.5 Flash Lite / Flash)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Secondary failover API key (optional, for high availability)
GEMINI_API_KEY_BACKUP=YOUR_BACKUP_GEMINI_API_KEY_HERE

# n8n Webhook Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/detect-disease
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http

# ------------------------------------------------------------------------------
# 3. STORAGE & DATABASE CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Database URL if deploying centralized case analytics
DATABASE_URL=postgresql://user:password@localhost:5432/krishi_marga_db
