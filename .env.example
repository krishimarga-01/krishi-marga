# ==============================================================================
# KRISHI MARGA — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your real .env or any production secret to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOBILE APP (EXPO) — BACKEND ENDPOINT
# ------------------------------------------------------------------------------
# The primary value the mobile app needs: a secure HTTPS endpoint for the FastAPI backend.
# The app appends the webhook paths itself:
#     <EXPO_PUBLIC_BACKEND_URL>/webhook/detect-disease
#     <EXPO_PUBLIC_BACKEND_URL>/webhook/scan-pesticide
#
# Accepted forms:
#     https://api.your-domain.com
#     https://api.your-domain.com/webhook
#     https://api.your-domain.com/webhook/detect-disease
#
# Production builds REQUIRE https. Cleartext HTTP is allowed only in __DEV__ mode.
EXPO_PUBLIC_BACKEND_URL=https://api.your-domain.com/webhook/detect-disease

# Optional: development-only endpoint, used ONLY when __DEV__ is true.
# Handy when testing against local FastAPI (http://127.0.0.1:8000). Never used in release.
# EXPO_PUBLIC_DEV_BACKEND_URL=http://127.0.0.1:8000/webhook/detect-disease

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND SERVER — NEVER BUNDLED INTO THE MOBILE APP
# ------------------------------------------------------------------------------
# Configure these on your FastAPI host / container (see backend_fastapi/.env.example):
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY_FAILOVER_1=optional-failover-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key
# PORT=8000
# HOST=0.0.0.0
# CORS_ORIGINS=*
