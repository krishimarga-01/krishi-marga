# ==============================================================================
# KRISHI MARGA — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your real .env or any production secret to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOBILE APP (EXPO) — BACKEND ENDPOINT
# ------------------------------------------------------------------------------
# The ONE value the mobile app needs. It must be a permanent HTTPS endpoint that
# fronts your n8n instance. The app appends the webhook paths itself:
#     <EXPO_PUBLIC_BACKEND_URL>/webhook/detect-disease
#     <EXPO_PUBLIC_BACKEND_URL>/webhook/scan-pesticide
#
# Accepted forms:
#     https://n8n.your-domain.com
#     https://n8n.your-domain.com/webhook
#     https://n8n.your-domain.com/webhook/detect-disease   (legacy full URL)
#
# Production builds REQUIRE https. The app no longer detects a LAN IP, reads the
# Expo debugger host, or falls back to a hardcoded address.
EXPO_PUBLIC_BACKEND_URL=https://your-n8n-host.example.com

# Optional: development-only endpoint, used ONLY when __DEV__ is true.
# Handy when testing against a local or tunnelled n8n. Never used in a release build.
# EXPO_PUBLIC_DEV_BACKEND_URL=https://your-tunnel-host.example.com

# ------------------------------------------------------------------------------
# 2. SERVER SIDE ONLY — NEVER BUNDLED INTO THE MOBILE APP
# ------------------------------------------------------------------------------
# The Gemini API key is configured inside n8n as an "Header Auth" credential
# named "Google Gemini API Key". It must NOT appear in the Expo app, in app.json,
# or in any EXPO_PUBLIC_* variable, because everything with the EXPO_PUBLIC_
# prefix is compiled into the shipped APK and is readable by anyone.
#
# Set these on the machine/container that runs n8n:
# GEMINI_API_KEY=
# GEMINI_API_KEY_BACKUP=

# n8n deployment settings (server side)
# N8N_PORT=5678
# N8N_HOST=0.0.0.0
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://your-n8n-host.example.com/

# ------------------------------------------------------------------------------
# 3. DATABASE (NOT CURRENTLY IMPLEMENTED)
# ------------------------------------------------------------------------------
# There is no Supabase or SQL integration in this codebase today. Cases are
# stored on-device with AsyncStorage (src/storage/caseStorage.ts). This entry is
# a placeholder for a future centralized analytics backend only.
# DATABASE_URL=
