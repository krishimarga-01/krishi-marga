# ==============================================================================
# KRISHI MARGA — FASTAPI PARALLEL BACKEND CONFIGURATION
# Copy this file to .env and configure the secrets for your environment.
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Google Gemini API Keys & Models
# Matches the 3-tier sequential failover architecture in n8n
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FAILOVER_1=gemini-3.6-flash
GEMINI_MODEL_FAILOVER_2=gemini-3.1-pro-preview

# Supabase (Cloud image storage & scan logging)
# Optional: if unconfigured, FastAPI operates gracefully without cloud persistence
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=crop-scans
SUPABASE_TABLE_NAME=scan_history

# ONNX Offline Inference
# Path to the bundled ONNX models (relative or absolute)
ONNX_MODELS_DIR=../models/onnx
ENABLE_LOCAL_ONNX_FALLBACK=true
